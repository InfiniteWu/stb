{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "shuatibao",
  "main": "worker/src/index.ts",
  "compatibility_date": "2026-09-12",
  // 不启用任何 compatibility_flags：本项目只用 Web 标准 API，
  // 不需要 nodejs_compat，保持冷启动最小。

  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    // 未知路径回落 index.html（前端是 hash 路由 SPA）
    "not_found_handling": "single-page-application",
    // 只有 /api/* 先进 Worker，其余请求由静态资源层直接响应，不计费也不耗 CPU
    "run_worker_first": ["/api/*"]
  },

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "shuatibao",
      // ⚠️ 占位值。执行 `npm run db:create` 后把返回的 database_id 填到这里。
      // 本地开发（wrangler dev / --local）不校验此值，可先用占位值跑通。
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "worker/migrations"
    }
  ],

  // ⚠️ 部署前取消注释并替换为你的自有域名。
  // 不使用 *.workers.dev（本机 DNS 被污染，且国内不可达）。
  // "routes": [{ "pattern": "刷题宝.example.com", "custom_domain": true }],

  // 本地开发的非敏感变量。密钥请用 `wrangler secret put`，不要写在这里。
  "vars": {
    "ENVIRONMENT": "development"
  },

  "observability": {
    "enabled": true
  }
}
