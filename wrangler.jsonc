{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "shuatibao",
  "main": "worker/src/index.ts",
  // 取值受测试工具链约束：@cloudflare/vitest-pool-workers 依赖的 miniflare
  // 捆绑的是 workerd 1.20260815（wrangler 自带的则更新），更高日期无法启动。
  // 这里刻意与测试保持同一个日期 —— 让「测试的运行时」与「线上的运行时」
  // 完全一致，而不是让测试偷偷跑在另一套语义上。
  // 待 vitest-pool-workers 升级 miniflare 后，可把此值一并上调。
  "compatibility_date": "2026-08-15",
  // 不启用任何 compatibility_flags：本项目只用 Web 标准 API，
  // 不需要 nodejs_compat，保持冷启动最小。

  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    // 未知路径回落 index.html（前端是 hash 路由 SPA）
    "not_found_handling": "single-page-application",
    // 只有 /api/* 先进 Worker，其余请求由静态资源层直接响应，不计费也不耗 CPU
    "run_worker_first": ["/api/*"]
  },

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "shuatibao",
      // 2026-09-12 创建。刻意指定 --location apac：
      // 默认会落在 WNAM（美西），对国内用户每次查询都要跨太平洋往返。
      "database_id": "4cad2ce1-53fc-4d43-b017-1122e50fd07c",
      "migrations_dir": "worker/migrations"
    }
  ],

  // 自有域名。写进配置而不是只靠控制台，否则下次部署会丢失绑定。
  // custom_domain 由 Cloudflare 自动签发并续期证书，无需自行管理 DNS 记录。
  "routes": [{ "pattern": "stb.jorinedu.top", "custom_domain": true }],

  // 关闭 *.workers.dev：本项目的访问入口只有上面的自有域名。
  // 该域名在国内 DNS 被污染、无法直连，留着既不实用又白白多一个入口。
  "workers_dev": false,
  // 预览 URL 同理关闭，避免每次部署产生一批可匿名访问的临时地址。
  "preview_urls": false,

  // 这里放的是**默认（生产）**取值。
  // 本地开发由 .dev.vars 覆盖为 development（见 .dev.vars.example）。
  // 密钥一律走 `wrangler secret put`，不要写进本文件。
  "vars": {
    "ENVIRONMENT": "production"
  },

  "observability": {
    "enabled": true
  }
}
